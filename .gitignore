# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
out/

# Claude Code (로컬 개인 설정)
.claude/

# OS
.DS_Store
Thumbs.db

# Logs / local
*.log
*.local
local.properties
/logs/

# 데모 TLS 인증서·개인키 (scripts/gen-demo-tls.ps1 로 로컬 생성)
/certs/

# Whale PoC 빌드 산출물 (scripts/whale-startup.ps1 / ./gradlew whalePackage 로 생성)
# 기존 output은 호환 경로이며 새 패키지는 results, 생성 키는 runtime으로 이동했다.
/output/libs/
/output/poc/

# 인증체인 재생성(scripts/gen-certs.ps1) 시 만들어지는 이전 자료 백업.
# 원본은 git 이력에 남아 있으므로 백업 디렉터리는 추적하지 않는다.
/output/certs.bak-*/

# 배포본(release/) — 실행 jar 약 84MB 를 포함하는 빌드 산출물이라 추적하지 않는다.
# 재생성: ./gradlew whalePackage 후 output/ 을 release/<날짜>-whale-poc/ 로 복사.
/release/

# 문서 작성 중간 산출물 (최종본은 EIF_차세대_상호운용성/02_최종문서/)
/_workspace/
/EIF_차세대_상호운용성/작업자료/

# 참조문서 통합 후에도 문서 작성 중간 산출물은 로컬 보존만 한다.
/참조문서/05_기존산출물_보존/EIF_차세대_상호운용성/작업자료/

# 실행 데이터·개인키·검증 결과와 main 로컬 백업은 추적하지 않는다.
/runtime/
/results/
/_backup/
# 재배치 전 패키지 경로의 잔여 로컬 산출물도 추적하지 않는다.
/output/
