<mxfile host="drawio"><diagram name="관리 영역과 배포 영역의 접근 경계" id="krtl-network"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="관리 영역과 배포 영역의 접근 경계" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#ffffff;text;align=left;fontSize=22;fontStyle=1;strokeColor=none;"><mxGeometry as="geometry" x="20" y="10" width="960" height="40" /></mxCell><mxCell id="p" value="인증사업자&#10;기존 VPN · mTLS" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#e6f4ea;"><mxGeometry as="geometry" x="20" y="100" width="280" height="90" /></mxCell><mxCell id="g" value="사업자 연계 서버&#10;IF-01 접수 · IF-03 전달" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#fdecea;"><mxGeometry as="geometry" x="340" y="100" width="280" height="90" /></mxCell><mxCell id="r" value="신뢰정보 관리 · TL 발행&#10;IF-04 스냅숏 · IF-05 HSM 서명" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#fdecea;"><mxGeometry as="geometry" x="340" y="290" width="280" height="90" /></mxCell><mxCell id="w" value="배포 WAS&#10;검증 · 게시 · 접속 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#eaf2fb;"><mxGeometry as="geometry" x="690" y="290" width="280" height="90" /></mxCell><mxCell id="web" value="배포 WEB&#10;외부 HTTPS · 프록시" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#eaf2fb;"><mxGeometry as="geometry" x="690" y="480" width="280" height="90" /></mxCell><mxCell id="u" value="이용기관 · 브라우저&#10;IF-07 요청 시작" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#f1eafb;"><mxGeometry as="geometry" x="340" y="480" width="280" height="90" /></mxCell><mxCell id="pg" value="IF-01" edge="1" parent="1" source="p" target="g" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Malgun Gothic;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;strokeColor=#586574;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="gr" value="IF-03" edge="1" parent="1" source="g" target="r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Malgun Gothic;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;strokeColor=#586574;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rw" value="IF-06" edge="1" parent="1" source="r" target="w" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Malgun Gothic;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;strokeColor=#586574;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ww" value="응답" edge="1" parent="1" source="w" target="web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Malgun Gothic;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;strokeColor=#586574;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="uw" value="IF-07" edge="1" parent="1" source="u" target="web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Malgun Gothic;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;strokeColor=#586574;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n" value="관리 → 배포 연결은 관리 쪽에서 시작한다. 배포 쪽에서 관리 영역으로 새 연결을 시작하지 않는다.&#10;배포 시스템에는 TL 서명키가 없다. 관리자 접근(IF-02)은 외부 배포 접근(IF-07)과 분리한다." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=17;spacing=8;strokeColor=#53667a;fillColor=#ffffff;fontSize=16;"><mxGeometry as="geometry" x="20" y="610" width="950" height="75" /></mxCell></root></mxGraphModel></diagram></mxfile>